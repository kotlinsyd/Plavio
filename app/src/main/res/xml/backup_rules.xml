<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Local file export is the only supported backup path. Exclude all
         preference files (including cloud credentials) if a legacy platform
         or OEM ignores android:allowBackup=false. -->
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
