<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained Pulse logo for in-app use (About screen).
     Single VectorDrawable: safe with painterResource, unlike the
     launcher layer-list which crashed on some devices. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#0B0B16" />
    <path
        android:pathData="M0,0h108v54h-108z"
        android:fillColor="#101024" />
    <!-- soft cyan glow -->
    <path
        android:pathData="M54,20a34,34 0 1,0 0.1,0Z"
        android:fillColor="#22D3EE"
        android:fillAlpha="0.14" />
    <!-- pulse waveform -->
    <path
        android:pathData="M14,54h12l7,-14l9,28l9,-22l7,8h30"
        android:fillColor="#00000000"
        android:strokeColor="#E879F9"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- play button fused on the waveform -->
    <path
        android:pathData="M45,36L73,54L45,72Z"
        android:fillColor="#FFFFFF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineJoin="round" />
</vector>
